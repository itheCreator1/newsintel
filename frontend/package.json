{
  "name": "newsintel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "generate:api": "openapi-typescript openapi.json -o src/types.generated.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.66.0",
    "@vueuse/core": "^13.0.0",
    "echarts": "^6.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
